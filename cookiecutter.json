{
  "ifdd_type_prj_name": "IFDD Type",
  "ifdd_type_prj_slug": "{{ cookiecutter.ifdd_type_prj_name|lower|replace(' ', '_') }}",
  "ifdd_type_host": "type",
  "ifdd_type_dev_port": "8082",
  "ifdd_type_autoindex": "y",
  "ifdd_type_cors_origin": "*",
  "ifdd_type_cache_max_age": "300",
  "ifdd_type_memory_limit": "128M",
  "ifdd_type_content_dir": "./examples/json-ld",
  "ifdd_type_url": "http://type/v1",
  "ifdd_unit_url": "http://unit/v1",
  "ifdd_nginx_image": "nginxinc/nginx-unprivileged:1.30.6-alpine-slim",
  "ifdd_proxy_network": "proxy-net",
  "_copy_without_render": [
    ".github",
    "tests"
  ]
}
