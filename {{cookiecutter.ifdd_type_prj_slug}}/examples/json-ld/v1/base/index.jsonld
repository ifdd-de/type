      },
      "definedBy": "{{ cookiecutter.ifdd_type_url }}/base/",
      "order": 90
    },
    {
      "@id": "{{ cookiecutter.ifdd_type_url }}/base/objName",
      "@type": "rdf:Property",
      "label": {
        "en": "Name",
        "de": "Name"
      },
      "comment": {
        "en": "Name of the object in this context.",
