{
  "@context": {
    "@version": 1.1,
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "sh": "http://www.w3.org/ns/shacl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "qudt": "http://qudt.org/schema/qudt/",
    "label": {
      "@id": "rdfs:label",
      "@container": "@language"
    },
    "comment": {
      "@id": "rdfs:comment",
      "@container": "@language"
    },
    "range": {
      "@id": "rdfs:range",
      "@type": "@id"
    },
    "definedBy": {
      "@id": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "order": {
      "@id": "sh:order",
      "@type": "xsd:integer"
    },
    "quantityKind": {
      "@id": "qudt:hasQuantityKind",
      "@type": "@id"
    },
    "applicableUnit": {
      "@id": "qudt:applicableUnit",
      "@type": "@id",
      "@container": "@set"
    },
    "symbol": "qudt:symbol",
    "exactMatch": {
      "@id": "skos:exactMatch",
      "@type": "@id"
    }
  },
  "@graph": [
    {
      "@id": "{{ cookiecutter.ifdd_type_url }}/base/",
      "@type": "owl:Ontology",
      "label": {
        "en": "Base",
        "de": "Basis"
      },
      "comment": {
        "en": "Values every object has: overview tables of the UI.",
        "de": "Werte, die jedes Objekt hat: Übersichtstabellen der UI."
      }
    },
    {
      "@id": "{{ cookiecutter.ifdd_type_url }}/base/schema",
      "@type": "rdfs:Class",
      "label": {
        "en": "Base",
        "de": "Basis"
      },
      "definedBy": "{{ cookiecutter.ifdd_type_url }}/base/"
    },
    {
      "@id": "{{ cookiecutter.ifdd_type_url }}/base/c_created",
      "@type": "rdf:Property",
      "label": {
        "en": "Created (source)",
        "de": "Angelegt (Quelle)"
      },
      "comment": {
        "en": "When the source created the object.",
        "de": "Wann die Quelle das Objekt angelegt hat."
      },
      "definedBy": "{{ cookiecutter.ifdd_type_url }}/base/",
      "order": 901,
      "range": "xsd:dateTime"
    },
    {
      "@id": "{{ cookiecutter.ifdd_type_url }}/base/c_modified",
      "@type": "rdf:Property",
      "label": {
        "en": "Modified (source)",
        "de": "Geändert (Quelle)"
      },
      "comment": {
        "en": "When the source last changed the object.",
        "de": "Wann die Quelle das Objekt zuletzt geändert hat."
      },
      "definedBy": "{{ cookiecutter.ifdd_type_url }}/base/",
      "order": 902,
      "range": "xsd:dateTime"
    },
    {
      "@id": "{{ cookiecutter.ifdd_type_url }}/base/c_cacheCreated",
      "@type": "rdf:Property",
      "label": {
        "en": "First stored",
        "de": "Erstmals gespeichert"
      },
      "comment": {
        "en": "When the backend first stored the object (set by the backend).",
        "de": "Wann das Backend das Objekt erstmals gespeichert hat (vom Backend gesetzt)."
      },
      "definedBy": "{{ cookiecutter.ifdd_type_url }}/base/",
      "order": 903,
      "range": "xsd:dateTime"
    },
    {
      "@id": "{{ cookiecutter.ifdd_type_url }}/base/c_cacheUpdated",
      "@type": "rdf:Property",
      "label": {
        "en": "Last confirmed",
        "de": "Zuletzt bestätigt"
      },
      "comment": {
        "en": "When the backend last stored or confirmed this version (set by the backend).",
        "de": "Wann das Backend diese Version zuletzt gespeichert oder bestätigt hat (vom Backend gesetzt)."
      },
      "definedBy": "{{ cookiecutter.ifdd_type_url }}/base/",
      "order": 904,
      "range": "xsd:dateTime"
    },
    {
      "@id": "{{ cookiecutter.ifdd_type_url }}/base/c_validNotBefore",
      "@type": "rdf:Property",
      "label": {
        "en": "Valid from",
        "de": "Gültig ab"
      },
      "comment": {
        "en": "Start of the valid time of this version.",
        "de": "Beginn der Gültigkeit dieser Version."
      },
      "definedBy": "{{ cookiecutter.ifdd_type_url }}/base/",
      "order": 905,
      "range": "xsd:dateTime"
    },
    {
      "@id": "{{ cookiecutter.ifdd_type_url }}/base/c_validNotAfter",
      "@type": "rdf:Property",
      "label": {
        "en": "Valid until",
        "de": "Gültig bis"
      },
      "comment": {
        "en": "End of the valid time of this version (exclusive).",
        "de": "Ende der Gültigkeit dieser Version (ausschließlich)."
      },
      "definedBy": "{{ cookiecutter.ifdd_type_url }}/base/",
      "order": 906,
      "range": "xsd:dateTime"
    },
    {
      "@id": "{{ cookiecutter.ifdd_type_url }}/base/aspect",
      "@type": "rdf:Property",
      "label": {
        "en": "Aspect",
        "de": "Aspekt"
      },
      "comment": {
        "en": "Kind of object: product, function, location or organisation.",
        "de": "Art des Objekts: Produkt, Funktion, Ort oder Organisation."
      },
      "definedBy": "{{ cookiecutter.ifdd_type_url }}/base/",
      "order": 70
    },
    {
      "@id": "{{ cookiecutter.ifdd_type_url }}/base/objType",
      "@type": "rdf:Property",
      "label": {
        "en": "Type",
        "de": "Typ"
      },
      "comment": {
        "en": "Type of the object as the source names it.",
